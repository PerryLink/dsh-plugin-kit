{
  // CI face: typecheck against the types installed in node_modules (published
  // packages). The kit has no checkout `paths` aliases and imports nothing
  // from `@deepseek-ai/*`, so this is the same program as `tsconfig.json`;
  // the separate face exists so `paths` to a harness checkout can be added to
  // `tsconfig.json` without changing what CI proves.
  "extends": "./tsconfig.json"
}
